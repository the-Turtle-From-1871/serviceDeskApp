generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id                String    @id @default(cuid())
  rank              String?
  name              String
  // citext: email identity is case-insensitive at the DB level, so both the
  // unique constraint and every lookup ignore case. Without it a mixed-case row
  // would be unfindable by the app's lowercased lookups (lockout) and would not
  // collide with its lowercase twin (duplicate identity).
  email             String    @unique @db.Citext
  unit              String?
  contactNumber     String?
  passwordHash      String
  signatureImage    String?
  role              Role      @default(USER)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  passwordChangedAt DateTime?
  // Set when the account transitions to inactive (cleared on reactivation). A
  // dedicated signal — unlike updatedAt, which any edit bumps — so the account
  // purge worker can hard-delete accounts deactivated for 3+ months. Existing
  // already-deactivated users have null here and are treated as not-yet-eligible.
  deactivatedAt     DateTime?

  createdItems        Item[]                @relation("CreatedItems")
  createdTransfers    Transfer[]            @relation("CreatedTransfers")
  importBatches       ImportBatch[]         @relation("ImportBatches")
  returnsProcessed    ReturnTransaction[]   @relation("ReturnsProcessed")
  passwordResets      PasswordResetToken[]  @relation("PasswordResets")
  itemEdits           ItemEdit[]            @relation("ItemEdits")
  itemAudits          ItemAudit[]           @relation("ItemAudits")
  itemStatusChanges   ItemStatusHistory[]   @relation("ItemStatusChanges")
  createdCategories   DeviceCategory[]      @relation("CreatedCategories")
  signatures          Signature[]           @relation("UserSignatures")
  createdContacts     Contact[]             @relation("CreatedContacts")
  publicAccessUpdates PublicAccessSetting[] @relation("PinUpdates")
}

// Self-service password reset. Only the SHA-256 hash of the emailed token is
// stored, so a DB leak can't be used to reset. Single-use (usedAt) + expiry.
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation("PasswordResets", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum ItemStatus {
  ACTIVE
  RETIRED
}

// Operational-readiness state of a device (distinct from ItemStatus, which is
// the lifecycle ACTIVE/RETIRED). Separate Postgres enum type — the shared
// RETIRED value name does not collide across enum types.
enum DeployableStatus {
  DEPLOYED
  READY_TO_DEPLOY
  IN_REPAIR
  RETIRED
}

model Item {
  id                         String            @id @default(cuid())
  make                       String
  model                      String
  // A device's identity. citext + unique: case-insensitive, so the same physical
  // device can't be logged twice (incl. "ABC123" vs "abc123"). Mirrors User.email.
  serialNumber               String            @unique @db.Citext
  homeUnit                   String?
  // Unit Identification Code (UIC) of the unit the device is issued to. Importable
  // and editable-via-import; a change is logged to ItemEdit like deviceName. Not a
  // DB-unique field — many devices share a UIC.
  deviceUIC                  String?
  deviceName                 String?
  // Free-text device class used to group the fleet in analytics and to filter
  // the /items table — "Laptops", "Switches", "Printers". Deliberately a
  // nullable String and NOT an enum: the set of categories is open-ended and
  // owned by the property book, so adding one must not require a migration.
  // Importable (see csv.ts) so the existing catalogue can be backfilled in bulk
  // through the normal CSV import rather than by hand. Normalized on write.
  deviceCategory             String?
  notes                      String?
  // The email of the person actually using the device. Distinct from the
  // hand-receipt holder (derived from the latest OPEN Transfer), which stays the
  // signed custody record and is never edited here. @map keeps the physical
  // column name ("currentUser") so renaming the field for clarity needs no
  // migration — the DB column is unchanged.
  currentUserEmail           String?           @map("currentUser")
  currentPosition            String?
  // MDM telemetry, imported from the asset/MDM CSV export and refreshed on each
  // import. Stored as-is (plain text — no date parsing). Nullable; blank on import
  // leaves the stored value untouched. Not editable from the UI.
  lastLogonUserPrincipalName String?
  lastLogonDate              String?
  enrollmentDate             String?
  compliance                 String?
  status                     ItemStatus        @default(ACTIVE)
  // Operational readiness (Day 1 sprint). isAccountedFor defaults true (assume
  // present until an audit says otherwise). deployableStatus is intentionally
  // nullable with NO default: existing rows stay "unknown" until triaged, and an
  // open hand receipt does NOT imply DEPLOYED (a device may be turned in for
  // service), so there is deliberately no automatic backfill.
  isAccountedFor             Boolean           @default(true)
  deployableStatus           DeployableStatus?
  createdBy                  User              @relation("CreatedItems", fields: [createdById], references: [id])
  createdById                String
  transferItems              TransferItem[]
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  // Denormalized MAX(ItemAudit.createdAt), maintained by recordAudit. Lets the
  // /items list ORDER BY audit recency (= audit-status severity) server-side:
  // auditState itself is derived/time-dependent and not stored, so it can't be an
  // ORDER BY, but this column can. Null = never audited (sorts last, both dirs).
  lastAuditedAt              DateTime?

  serviceQueueItem ServiceQueueItem?
  edits            ItemEdit[]
  audits           ItemAudit[]
  statusHistory    ItemStatusHistory[]

  // The /items list sorts by createdAt desc on every load (unbounded today).
  @@index([createdAt])
  // Analytics groups/filters the fleet by category and by issuing unit, and the
  // /items table filters on deviceUIC. Both are low-cardinality equality
  // filters feeding groupBy — a plain B-tree serves them.
  @@index([deviceCategory])
  @@index([deviceUIC])
  // Audit-status sort on /items: ORDER BY lastAuditedAt (nulls last).
  @@index([lastAuditedAt])
  // Trigram GIN for the public, per-keystroke serial search (searchItemsBySerial),
  // which is `ILIKE '%q%'` — a leading wildcard a B-tree can't serve. Needs pg_trgm.
  @@index([serialNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Item_serialNumber_trgm_idx")
}

// The managed vocabulary of device categories ("Laptops", "Switches"), curated
// by admins.
//
// DELIBERATELY NOT A FOREIGN KEY on Item. `Item.deviceCategory` stays a plain
// indexed string, because the CSV import must be able to carry a category for a
// device the property book has not registered yet — the same "learn as you go"
// model the Unit table uses. This table is the *canonical list* that the UI
// offers and that the importer teaches itself, not a constraint that can make an
// import fail. Consequence to keep in mind: deleting a row here does not touch
// items already carrying that string, which is exactly why deletion is refused
// while the category is still in use (see deleteDeviceCategory).
model DeviceCategory {
  id String @id @default(cuid())
  // citext + unique: "Laptops" and "laptops" are one category, not two.
  // Mirrors User.email / Item.serialNumber identity handling.
  name        String   @unique @db.Citext
  createdBy   User?    @relation("CreatedCategories", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

model Unit {
  id           String   @id @default(cuid())
  abbreviation String   @unique
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum TransferStatus {
  OPEN
  CLOSED
}

enum ReturnKind {
  PARTIAL
  FULL
}

model Transfer {
  id            String         @id @default(cuid())
  receiptNumber String         @unique
  itemSummary   String
  lines         TransferLine[]

  senderIsDcsim Boolean @default(false)
  senderName    String
  senderRank    String?
  senderUnit    String?
  senderContact String?
  senderEmail   String?

  receiverIsDcsim Boolean @default(false)
  receiverName    String
  receiverRank    String?
  receiverUnit    String?
  receiverContact String?
  receiverEmail   String?

  receiverSignature String

  // Ed25519 signature (base64) over the canonical handoff manifest, produced at
  // creation. Null when unsealed: pre-existing rows, or best-effort failures when
  // SIGNING_PRIVATE_KEY is absent/invalid. Verified via verifyReceiptSealAction.
  cryptoSignature String?

  // The exact server timestamp fed into the signed manifest. Persisted (not
  // reusing createdAt, whose DB default stamps a hair later) so the signed bytes
  // can be reproduced for verification. timestamp(3) round-trips toISOString().
  sealedAt DateTime?

  // Immutable snapshot of the acting technician's user id at seal time. Plain
  // text, NOT a User relation: the createdByUser FK is ON DELETE SET NULL, so
  // signing over that nullable value makes an intact receipt verify as TAMPERED
  // once the technician's account is deleted. The seal binds THIS field;
  // createdByUserId stays the live (nullable) relation for display/joins.
  sealedByUserId String?

  createdByUser   User?   @relation("CreatedTransfers", fields: [createdByUserId], references: [id])
  createdByUserId String?

  status    TransferStatus @default(OPEN)
  createdAt DateTime       @default(now())

  // Lifecycle: set when the receipt (ticket) transitions to CLOSED. Once set the
  // record is immutable. `purgeAfter` = closedAt + 90 days; the purge worker
  // permanently deletes records whose purgeAfter has passed.
  closedAt   DateTime?
  purgeAfter DateTime?

  // Return timer: optional deadline for the borrower to bring items back. Null =
  // no timer. `overdueAlertedAt` is stamped when the single overdue email fires,
  // so the cron sweep never emails the same lapsed receipt twice; editing the
  // deadline to a new future date clears it so the fresh deadline can alert.
  dueAt            DateTime?
  overdueAlertedAt DateTime?

  returns ReturnTransaction[] @relation("TransferReturns")

  // [Ingest & Routing Queue] Back-reference for the service queue. Every ingested
  // receipt is routed into the primary service queue (see ServiceQueueItem).
  queueItems ServiceQueueItem[] @relation("TransferQueueItems")

  @@index([purgeAfter])
  @@index([dueAt])
  // Audit log, receipt-number search, and per-item receipt lists all sort by
  // createdAt desc.
  @@index([createdAt])
  // Dashboard timer sweep filters status='OPEN' AND dueAt <= horizon.
  @@index([status, dueAt])
  // Trigram GIN for the public, per-keystroke receipt-number search
  // (searchReceiptsByNumber), `ILIKE '%q%'`. Needs pg_trgm.
  @@index([receiptNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Transfer_receiptNumber_trgm_idx")
}

model TransferLine {
  id          String         @id @default(cuid())
  transfer    Transfer       @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferId  String
  lineNo      Int
  make        String
  model       String
  unitOfIssue String         @default("EA")
  qtyAuth     Int
  qtyIssued   Int
  items       TransferItem[]

  @@index([transferId])
}

model TransferItem {
  id             String       @id @default(cuid())
  line           TransferLine @relation(fields: [transferLineId], references: [id], onDelete: Cascade)
  transferLineId String
  item           Item         @relation(fields: [itemId], references: [id])
  itemId         String
  serialNumber   String
  returnedAt     DateTime?

  @@index([itemId])
  @@index([transferLineId])
}

model ImportBatch {
  id           String   @id @default(cuid())
  createdBy    User     @relation("ImportBatches", fields: [createdById], references: [id])
  createdById  String
  filename     String
  addedCount   Int
  updatedCount Int      @default(0)
  skippedCount Int
  skipped      Json
  createdAt    DateTime @default(now())

  @@index([createdById])
}

model ReturnTransaction {
  id                   String     @id @default(cuid())
  transfer             Transfer   @relation("TransferReturns", fields: [transferId], references: [id], onDelete: Cascade)
  transferId           String
  receiptNumber        String
  kind                 ReturnKind
  processedByUser      User?      @relation("ReturnsProcessed", fields: [processedByUserId], references: [id])
  processedByUserId    String?
  processedByName      String
  processedByEmail     String
  processedBySignature String?
  returned             Json
  returnedCount        Int
  remainingCount       Int
  createdAt            DateTime   @default(now())

  @@index([transferId])
}

// [Service Queue] Service requested for a queued item.
enum ServiceType {
  REIMAGE
  REPAIR
  OTHER // free-text detail in ServiceQueueItem.serviceNote
}

// [Service Queue] Lifecycle for an item's service request.
enum ServiceQueueStatus {
  // In the queue: the item needs active service/intervention.
  PENDING
  // Service done. Retained (never deleted), drops off the active queue, and can
  // be reopened (PENDING) from the item detail page.
  COMPLETED
}

// [Service Queue] One service request per item. Present with status PENDING ==
// "needs service" (shown on the queue). The item may optionally be tied to the
// hand receipt it was flagged on (transferId), shown on the item detail page.
model ServiceQueueItem {
  id          String             @id @default(cuid())
  item        Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      String             @unique
  transfer    Transfer?          @relation("TransferQueueItems", fields: [transferId], references: [id], onDelete: SetNull)
  transferId  String?
  serviceType ServiceType
  serviceNote String?
  status      ServiceQueueStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Completion SLA timer. dueAt defaults from the service type (see sla.ts) when
  // the item is flagged, overridable per item. Null = no timer. overdueAlertedAt
  // mirrors Transfer's — one alert per lapse, reset when the item is re-flagged.
  dueAt            DateTime?
  overdueAlertedAt DateTime?

  @@index([status])
  @@index([transferId])
  @@index([dueAt])
}

// History of edits to an Item's loggable fields. One row per save that actually
// changed something (a no-op save writes nothing).
model ItemEdit {
  id           String   @id @default(cuid())
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId       String
  // Nullable + SetNull, with a denormalized name snapshot, so history survives
  // the editor's account being deleted (mirrors ReturnTransaction.processedBy*).
  editedBy     User?    @relation("ItemEdits", fields: [editedById], references: [id], onDelete: SetNull)
  editedById   String?
  editedByName String
  // [{ field, from, to }] — only the fields that changed.
  changes      Json
  createdAt    DateTime @default(now())

  @@index([itemId])
  @@index([createdAt])
}

// A named signature belonging to an ADMIN account. `name` is the technician the
// signature belongs to — it is printed on the DA 2062 as the signer when this
// signature is chosen on a return, so it is an identity, not a label.
// Non-admin accounts keep the single `User.signatureImage` instead.
model Signature {
  id        String   @id @default(cuid())
  user      User     @relation("UserSignatures", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  image     String // PNG data URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

// A saved recipient for hand receipts — shared org-wide (any signed-in user
// reads it for autofill; only admins write to it). Distinct from User: these are
// outside people who receive equipment and have no login account.
model Contact {
  id            String  @id @default(cuid())
  rank          String?
  // Split (rather than a single free-text `name` like User.name) so ordering by
  // last name is a plain indexed DB sort. Parsing a surname out of one column
  // misfiles "Van Der Berg" and "Doe Jr.". Transfer.receiverName stays a single
  // String; autofill composes "First Last" when filling it.
  firstName     String
  lastName      String
  unit          String?
  contactNumber String?
  // citext + unique: one inbox, one contact. Mirrors User.email — the app
  // lowercases on write, so a mixed-case row would otherwise be unfindable by
  // lookups and would not collide with its lowercase twin.
  email         String  @unique @db.Citext

  // Nullable + SetNull (mirrors ItemEdit.editedBy): the shared book must survive
  // deletion of the account that happened to add a row.
  createdBy   User?   @relation("CreatedContacts", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
}

// History of possession audits for an item. One row per audit event; an item's
// audit status is derived from the newest row (see modules/audit/audit.status.ts).
// Nullable auditor + denormalized name/signature snapshots so history survives
// deletion of the acting account or the source Signature (mirrors ItemEdit /
// ReturnTransaction).
model ItemAudit {
  id             String   @id @default(cuid())
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId         String
  auditedBy      User?    @relation("ItemAudits", fields: [auditedById], references: [id], onDelete: SetNull)
  auditedById    String?
  auditedByName  String
  signerName     String
  signatureImage String
  createdAt      DateTime @default(now())

  @@index([itemId, createdAt])
}

// Operational-readiness timeline for an item. One row per change to
// deployableStatus or isAccountedFor, written in the same transaction as the
// Item update so the two can never diverge.
//
// SNAPSHOT, not a delta: each row records the item's state *after* the change,
// so the fleet's composition at any instant T is "for each item, the newest row
// with createdAt <= T" — one indexed DISTINCT ON, with no need to replay deltas
// from the beginning of time. That is what the stacked-area chart reads.
//
// Forward-only by design. The migration seeds ONE baseline row per existing
// item at backfill time; there is no invented history before that point,
// because none was ever recorded. Charts are therefore flat until real changes
// accrue — that is honest, not a bug.
//
// Nullable actor + denormalized name snapshot so the timeline survives deletion
// of the acting account (mirrors ItemEdit / ItemAudit).
model ItemStatusHistory {
  id               String            @id @default(cuid())
  item             Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId           String
  // The item's state as of this row. deployableStatus stays nullable because
  // an untriaged item legitimately has no readiness state yet (see Item).
  deployableStatus DeployableStatus?
  isAccountedFor   Boolean
  changedBy        User?             @relation("ItemStatusChanges", fields: [changedById], references: [id], onDelete: SetNull)
  changedById      String?
  changedByName    String
  // "system:backfill" for the migration's baseline rows, "bulk" for a bulk
  // action, "item-edit" for a single-item save. Lets the timeline explain a
  // step change without joining anything.
  source           String
  createdAt        DateTime          @default(now())

  // The chart's hot path: newest row per item at or before a cutoff.
  @@index([itemId, createdAt])
  // Range scan when bucketing the whole fleet over a window.
  @@index([createdAt])
}

// Single-row org config for the public-access PIN gate. `id` is pinned to
// "singleton" so there is exactly one row (upserted). Stores only the bcrypt
// hash of the 8-digit PIN — never the PIN. `updatedBy` is nullable + SetNull so
// the row survives deletion of the admin who last set it (mirrors ItemEdit).
// New tables inherit RLS-enabled/deny-all via the rls_auto_enable trigger; the
// app reaches this only through Prisma (see CLAUDE.md §6).
model PublicAccessSetting {
  id          String   @id @default("singleton")
  pinHash     String
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("PinUpdates", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?

  @@index([updatedById])
}
