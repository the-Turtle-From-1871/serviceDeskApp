generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  VIEWER
}

// The unit of authorization. A role supplies a BASELINE set (see
// src/modules/users/capabilities.ts, which is the single definition of that
// mapping); UserCapability rows ADD to it. There is deliberately no negative
// grant — a subtractive model makes the effective set depend on the order two
// tables are read in, and the wrong answer to "does a deny beat a grant?" is a
// privilege bug. To reduce an account below its baseline, change its role.
enum Capability {
  VIEW_INVENTORY
  VIEW_ALL_RECEIPTS
  CREATE_RECEIPTS
  EDIT_ITEM_HOLDER
  MANAGE_ITEMS
  MANAGE_QUEUE
  PROCESS_RETURNS
  VIEW_ANALYTICS
  ADMINISTER
}

model User {
  id                String    @id @default(cuid())
  rank              String?
  name              String
  // citext: email identity is case-insensitive at the DB level, so both the
  // unique constraint and every lookup ignore case. Without it a mixed-case row
  // would be unfindable by the app's lowercased lookups (lockout) and would not
  // collide with its lowercase twin (duplicate identity).
  email             String    @unique @db.Citext
  unit              String?
  contactNumber     String?
  passwordHash      String
  signatureImage    String?
  role              Role      @default(USER)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  passwordChangedAt DateTime?
  // Set when the account transitions to inactive (cleared on reactivation). A
  // dedicated signal — unlike updatedAt, which any edit bumps — so the account
  // purge worker can hard-delete accounts deactivated for 3+ months. Existing
  // already-deactivated users have null here and are treated as not-yet-eligible.
  deactivatedAt     DateTime?
  // Set when the address is proved by clicking the emailed link. NULL means
  // unproved: sign-in is refused (src/auth.ts) and the address is never used to
  // scope the hand-receipt list, because an unproved address is a claim about
  // someone else's mailbox, not evidence.
  emailVerifiedAt   DateTime?

  createdItems        Item[]                @relation("CreatedItems")
  createdTransfers    Transfer[]            @relation("CreatedTransfers")
  importBatches       ImportBatch[]         @relation("ImportBatches")
  returnsProcessed    ReturnTransaction[]   @relation("ReturnsProcessed")
  passwordResets      PasswordResetToken[]  @relation("PasswordResets")
  itemEdits           ItemEdit[]            @relation("ItemEdits")
  itemAudits          ItemAudit[]           @relation("ItemAudits")
  createdCategories   DeviceCategory[]      @relation("CreatedCategories")
  signatures          Signature[]           @relation("UserSignatures")
  createdContacts     Contact[]             @relation("CreatedContacts")
  publicAccessUpdates PublicAccessSetting[] @relation("PinUpdates")
  receiptDrafts       ReceiptDraft[]        @relation("ReceiptDrafts")
  capabilities        UserCapability[]      @relation("UserCapabilities")
  capabilitiesGranted UserCapability[]      @relation("GrantedCapabilities")
  emailVerifications  EmailVerificationToken[] @relation("EmailVerifications")
  permissionRequests  PermissionRequest[]      @relation("PermissionRequests")
  permissionDecisions PermissionRequest[]      @relation("PermissionDecisions")
}

enum RequestStatus {
  OPEN
  CLOSED
}

enum Decision {
  PENDING
  APPROVED
  DENIED
}

// One ask, one justification, many capability lines decided individually.
//
// The denial reason lives on the REQUEST rather than the item: an admin denies
// by unchecking lines and gives one reason covering everything withheld, which
// mirrors the single justification on the request side. Denied items read it
// through their request.
model PermissionRequest {
  id            String                  @id @default(cuid())
  user          User                    @relation("PermissionRequests", fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  justification String
  status        RequestStatus           @default(OPEN)
  denialReason  String?
  createdAt     DateTime                @default(now())
  decidedAt     DateTime?
  decidedBy     User?                   @relation("PermissionDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedById   String?
  items         PermissionRequestItem[]

  @@index([status, createdAt])
  @@index([userId])
}

model PermissionRequestItem {
  id         String            @id @default(cuid())
  request    PermissionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId  String
  capability Capability
  decision   Decision          @default(PENDING)

  @@unique([requestId, capability])
  @@index([requestId])
}

// Proves control of an email address at sign-up. Only the SHA-256 hash of the
// emailed token is stored, so a DB leak cannot be used to verify someone else's
// address. Single-use (usedAt) + expiry, exactly like PasswordResetToken.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  user      User      @relation("EmailVerifications", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One additive grant of one capability to one user. `grantedById` is the admin
// who approved it and is SET NULL rather than cascaded: deleting the approver's
// account must not silently revoke everyone they ever granted.
model UserCapability {
  id          String     @id @default(cuid())
  user        User       @relation("UserCapabilities", fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  capability  Capability
  grantedBy   User?      @relation("GrantedCapabilities", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedById String?
  grantedAt   DateTime   @default(now())

  @@unique([userId, capability])
  @@index([userId])
}

// Self-service password reset. Only the SHA-256 hash of the emailed token is
// stored, so a DB leak can't be used to reset. Single-use (usedAt) + expiry.
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation("PasswordResets", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum ItemStatus {
  ACTIVE
  RETIRED
}

// NOTE: a `DeployableStatus` enum lived here and was dropped along with the
// column that used it. Readiness is now a DERIVED value with no stored
// representation — its states live as a TypeScript union in
// modules/items/readiness.ts, so there is nothing for Postgres to enumerate.

model Item {
  id                         String            @id @default(cuid())
  make                       String
  model                      String
  // A device's identity. citext + unique: case-insensitive, so the same physical
  // device can't be logged twice (incl. "ABC123" vs "abc123"). Mirrors User.email.
  serialNumber               String            @unique @db.Citext
  homeUnit                   String?
  // Unit Identification Code (UIC) of the unit the device is issued to. Importable
  // and editable-via-import; a change is logged to ItemEdit like deviceName. Not a
  // DB-unique field — many devices share a UIC.
  deviceUIC                  String?
  deviceName                 String?
  /// The device name MDM wants, recorded ONLY when the import refused to apply
  /// it. An MDM re-enrolment hands a device an autogenerated name
  /// (`BE-` + 12 chars) which would replace a meaningful one, so the import
  /// keeps the stored name and parks the proposed one here instead of losing
  /// it. Non-null therefore means "someone should rename this in Intune"; the
  /// import clears it as soon as MDM's name stops disagreeing. Never set by a
  /// hand edit — it is the importer's note to a human, not an editable field.
  mdmProposedName            String?
  // Free-text device class used to group the fleet in analytics and to filter
  // the /items table — "Laptops", "Switches", "Printers". Deliberately a
  // nullable String and NOT an enum: the set of categories is open-ended and
  // owned by the property book, so adding one must not require a migration.
  // Importable (see csv.ts) so the existing catalogue can be backfilled in bulk
  // through the normal CSV import rather than by hand. Normalized on write.
  deviceCategory             String?
  // Where the device physically sits when nobody is holding it — the fleet
  // export's "SLoc" column. Free text and NOT a managed vocabulary (unlike
  // deviceCategory/homeUnit): it is a lookup value read one item at a time,
  // with no analytics or filter grouping the fleet by it, so an unrecognised
  // SLoc arriving in a CSV must never fail a row.
  //
  // Deliberately NOT @map'd: the raw-SQL half of the /items search filter names
  // PHYSICAL columns, and currentUserEmail @map("currentUser") is the standing
  // example of what diverging names cost. Deliberately NOT indexed either — it
  // joins deviceName/make/model in an ILIKE '%q%' branch and none of those is
  // indexed; only serialNumber carries a trigram GIN, because it backs the
  // public per-keystroke search. Revisit if the fleet grows an order of
  // magnitude.
  storageLocation            String?
  /// Pool stock: a device kept to lend out temporarily, over and over.
  ///
  /// STORED rather than derived, unlike readiness and accountability — and the
  /// distinction is the reason this column is allowed to exist. Those two were
  /// dropped because they stored answers the data already knew. NOTHING here can
  /// infer loaner-ness: no signal separates a laptop kept for lending from an
  /// identical one issued permanently. It is a standing decision by the property
  /// manager, so a person is the only possible source.
  ///
  /// DELIBERATELY NOT IMPORTABLE. The CSV importer writes a named column set
  /// (see import.ts), and this is not in it — which is the entire reason it is a
  /// new column rather than a reused deviceCategory/homeUnit/storageLocation.
  /// Any of those would be reverted by the nightly Drive import within a day.
  isLoaner                   Boolean           @default(false)
  notes                      String?
  // The email of the person actually using the device. Distinct from the
  // hand-receipt holder (derived from the latest OPEN Transfer), which stays the
  // signed custody record and is never edited here. @map keeps the physical
  // column name ("currentUser") so renaming the field for clarity needs no
  // migration — the DB column is unchanged.
  currentUserEmail           String?           @map("currentUser")
  currentPosition            String?
  // MDM telemetry, imported from the asset/MDM CSV export and refreshed on each
  // import. Stored as-is (plain text — no date parsing). Nullable; blank on import
  // leaves the stored value untouched. Not editable from the UI.
  lastLogonUserPrincipalName String?
  lastLogonDate              String?
  // `lastLogonDate` parsed to an instant at import time (parseMdmDateTime).
  // Denormalized for the same reason as lastAuditedAt: readiness compares the
  // last logon to markedReadyAt, and the dashboard has to make that comparison
  // across the whole fleet in SQL. Parsing the free-text column inside Postgres
  // would abort an import on the first unexpected format. Null = absent or
  // unparseable; the raw string above is always kept for display.
  lastLogonAt                DateTime?
  enrollmentDate             String?
  compliance                 String?
  // When MDM last CHECKED IN with the device — a different question from
  // lastLogonDate, which is when a PERSON last signed in. A device sitting
  // powered-on in a cage syncs nightly with no logon for months; a device
  // someone took home syncs only when it sees the network. Stored verbatim like
  // enrollmentDate/compliance above and rendered as-is, so it matches the MDM
  // export people cross-check against.
  lastSyncDateTime           String?
  // `lastSyncDateTime` parsed to an instant at import time, by the SAME parser
  // as lastLogonAt (parseMdmDateTime — one parser, two columns, because the
  // export writes both in one format).
  //
  // It shipped 2026-08-10 WITHOUT this twin, on the reasoning that nothing
  // computed over the sync time. That stopped being true on 2026-08-11: the
  // dormant-device chase list now measures MDM silence rather than sign-in
  // silence, and it buckets 1,200 items in SQL, which raw text cannot do
  // (`ORDER BY`/`BETWEEN` on '10/1/2025' vs '7/25/2026' compares strings).
  // Null = absent or unparseable — a real and COMMON state here, because the
  // column is newer than most rows; the export fills it in on the next import.
  lastSyncAt                 DateTime?
  status                     ItemStatus        @default(ACTIVE)
  // READINESS IS DERIVED, NOT STORED — see modules/items/readiness.ts.
  //
  // A `deployableStatus` enum column lived here and was dropped. It was written
  // only by a bulk admin action, so 0 of 1,139 production rows ever had a value
  // and every device read "Untriaged": the column measured its own default, not
  // the fleet. Same lesson as the isAccountedFor flag dropped before it. Do not
  // reintroduce either — readiness is computed from lifecycle status, the
  // service queue, open hand receipts, and MDM last-logon.
  //
  // `markedReadyAt` is the ONE piece an operator sets by hand: "this is back in
  // our possession". A TIMESTAMP rather than a boolean on purpose — it lets the
  // marking be COMPARED to other dated signals and makes "when did we last have
  // hands on this" answerable. It does NOT self-expire: the rule that let a
  // newer logon override it was removed, because a device on our own shelf
  // produces logons routinely (imaging, MDM check-in, a test before reissue).
  // The marking stands until a deliberate act supersedes it — an open receipt,
  // a service flag, retirement, or an explicit clear.
  markedReadyAt              DateTime?
  createdBy                  User              @relation("CreatedItems", fields: [createdById], references: [id])
  createdById                String
  transferItems              TransferItem[]
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  // Denormalized MAX(ItemAudit.createdAt), maintained by recordAudit. Lets the
  // /items list ORDER BY audit recency server-side:
  // auditState itself is derived/time-dependent and not stored, so it can't be an
  // ORDER BY, but this column can. Null = never audited — and it is ordered as
  // a VALUE, not pinned: no sort key pins its blanks, so nulls swap ends with
  // the direction (see orderClauseFor). NOTE: the /items Audit sort no longer
  // uses this column for ordering — `auditState` is a DERIVED sort key ranked by
  // badge severity in SQL (auditRankSql / AUDIT_ORDER), so a timestamp that is
  // near-unique per row can't swallow the secondary sort key. This column still
  // backs the badge itself and the dashboard aggregate.
  lastAuditedAt              DateTime?
  // When an MDM import last CARRIED this serial — stamped on every row an
  // import touched, including rows it changed nothing on. "MDM still knows
  // about this device", as distinct from lastSyncAt's "MDM last spoke to it".
  //
  // WHY IT IS STORED WHEN SO LITTLE ELSE HERE IS: this is an OBSERVATION, not a
  // state. It records that a file arrived containing this serial at a moment in
  // time, which nothing else in the database remembers — a row absent from a
  // CSV leaves no trace anywhere by definition. It is not the hand-tickable
  // flag `isAccountedFor` and `deployableStatus` were (see below); nobody can
  // set it, and it is written by exactly one code path.
  //
  // DROPPED-OFF-NETWORK IS DERIVED FROM IT, NOT STORED. A device is dropped off
  // when this stamp predates the newest FLEET CENSUS import, and the date it
  // dropped off is the earliest census after this stamp — see
  // analytics.service.ts. Storing a `droppedOffAt` instead would need clearing
  // when the device reappears, and a flag that must be un-set is exactly the
  // shape this schema keeps refusing.
  //
  // NULL means no import has ever carried the serial, which is a different
  // thing from having dropped off and is deliberately NOT flagged: those
  // devices are the "Never enrolled" half of the same list.
  lastImportedAt            DateTime?

  serviceQueueItem ServiceQueueItem?
  edits            ItemEdit[]
  audits           ItemAudit[]

  // The /items list sorts by createdAt desc on every load (unbounded today).
  @@index([createdAt])
  // Analytics groups/filters the fleet by category and by issuing unit, and the
  // /items table filters on deviceUIC. Both are low-cardinality equality
  // filters feeding groupBy — a plain B-tree serves them.
  @@index([deviceCategory])
  @@index([deviceUIC])
  // Low-cardinality equality filter feeding a paginated list, same as
  // deviceCategory/deviceUIC above.
  @@index([isLoaner])
  // Audit-status sort on /items: a bare ORDER BY lastAuditedAt, no nulls override.
  @@index([lastAuditedAt])
  // Readiness derivation reads these two on every dashboard aggregate and on
  // the /items readiness sort. Both are nullable and mostly-null today, so a
  // plain B-tree is the right shape.
  @@index([markedReadyAt])
  @@index([lastLogonAt])
  // The dormant-device window (`lastSyncAt >= from AND < to`) is a range scan
  // over a mostly-null column on every dashboard load — the same shape as
  // lastLogonAt above, and the same plain B-tree.
  @@index([lastSyncAt])
  // The dropped-off-network list compares this against the newest census
  // import, and it is mostly-null today — the same shape as the two above.
  @@index([lastImportedAt])
  // Trigram GIN for the public, per-keystroke serial search (searchItemsBySerial),
  // which is `ILIKE '%q%'` — a leading wildcard a B-tree can't serve. Needs pg_trgm.
  @@index([serialNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Item_serialNumber_trgm_idx")
}

// The managed vocabulary of device categories ("Laptops", "Switches"), curated
// by admins.
//
// DELIBERATELY NOT A FOREIGN KEY on Item. `Item.deviceCategory` stays a plain
// indexed string, because the CSV import must be able to carry a category for a
// device the property book has not registered yet — the same "learn as you go"
// model the Unit table uses. This table is the *canonical list* that the UI
// offers and that the importer teaches itself, not a constraint that can make an
// import fail. Consequence to keep in mind: deleting a row here does not touch
// items already carrying that string, which is exactly why deletion is refused
// while the category is still in use (see deleteDeviceCategory).
model DeviceCategory {
  id String @id @default(cuid())
  // citext + unique: "Laptops" and "laptops" are one category, not two.
  // Mirrors User.email / Item.serialNumber identity handling.
  name        String   @unique @db.Citext
  createdBy   User?    @relation("CreatedCategories", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

model Unit {
  id           String   @id @default(cuid())
  // citext, like User.email and Item.serialNumber: an abbreviation is an
  // identity, and "WABC01" / "wabc01" are the same unit. Without it the
  // uppercasing in learnUnits is convention-only, so any write site that
  // forgets it forks the unit into a second row that resolves differently —
  // and the importer would then resolve device names inconsistently depending
  // on which row it happened to match.
  abbreviation String   @unique @db.Citext
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum TransferStatus {
  OPEN
  CLOSED
}

enum ReturnKind {
  PARTIAL
  FULL
}

model Transfer {
  id            String         @id @default(cuid())
  receiptNumber String         @unique
  itemSummary   String
  lines         TransferLine[]

  senderIsDcsim Boolean @default(false)
  senderName    String
  senderRank    String?
  senderUnit    String?
  senderContact String?
  senderEmail   String?

  receiverIsDcsim Boolean @default(false)
  receiverName    String
  receiverRank    String?
  receiverUnit    String?
  receiverContact String?
  receiverEmail   String?

  receiverSignature String

  // Ed25519 signature (base64) over the canonical handoff manifest, produced at
  // creation. Null when unsealed: pre-existing rows, or best-effort failures when
  // SIGNING_PRIVATE_KEY is absent/invalid. Verified via verifyReceiptSealAction.
  cryptoSignature String?

  // The exact server timestamp fed into the signed manifest. Persisted (not
  // reusing createdAt, whose DB default stamps a hair later) so the signed bytes
  // can be reproduced for verification. timestamp(3) round-trips toISOString().
  sealedAt DateTime?

  // Immutable snapshot of the acting technician's user id at seal time. Plain
  // text, NOT a User relation: the createdByUser FK is ON DELETE SET NULL, so
  // signing over that nullable value makes an intact receipt verify as TAMPERED
  // once the technician's account is deleted. The seal binds THIS field;
  // createdByUserId stays the live (nullable) relation for display/joins.
  sealedByUserId String?

  createdByUser   User?   @relation("CreatedTransfers", fields: [createdByUserId], references: [id])
  createdByUserId String?

  status    TransferStatus @default(OPEN)
  createdAt DateTime       @default(now())

  // Lifecycle: set when the receipt (ticket) transitions to CLOSED. Once set the
  // record is immutable. `purgeAfter` = closedAt + 90 days; the purge worker
  // permanently deletes records whose purgeAfter has passed.
  closedAt   DateTime?
  purgeAfter DateTime?

  // Return timer: optional deadline for the borrower to bring items back. Null =
  // no timer. `overdueAlertedAt` is stamped when the single overdue email fires,
  // so the cron sweep never emails the same lapsed receipt twice; editing the
  // deadline to a new future date clears it so the fresh deadline can alert.
  dueAt            DateTime?
  overdueAlertedAt DateTime?

  returns ReturnTransaction[] @relation("TransferReturns")

  // [Ingest & Routing Queue] Back-reference for the service queue. Every ingested
  // receipt is routed into the primary service queue (see ServiceQueueItem).
  queueItems ServiceQueueItem[] @relation("TransferQueueItems")

  @@index([purgeAfter])
  @@index([dueAt])
  // Audit log, receipt-number search, and per-item receipt lists all sort by
  // createdAt desc.
  @@index([createdAt])
  // Dashboard timer sweep filters status='OPEN' AND dueAt <= horizon.
  @@index([status, dueAt])
  // Analytics velocity chart filters status='CLOSED' AND closedAt >= start on
  // every dashboard load (all state is URL-driven, so each filter change
  // re-queries). No existing index serves a closedAt range — [status, dueAt]
  // cannot, and purgeAfter is a different column.
  @@index([status, closedAt])
  // Trigram GIN for the public, per-keystroke receipt-number search
  // (searchReceiptsByNumber), `ILIKE '%q%'`. Needs pg_trgm.
  @@index([receiptNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Transfer_receiptNumber_trgm_idx")
  // Trigram GIN for the recipient-name branch of item search, `ILIKE '%token%'`.
  // Needs pg_trgm. In practice only the PRISMA path (the `some` twin in
  // items.service.ts) reaches it: recipientMatchSql's raw-SQL EXISTS is
  // correlated on `ti."itemId" = i."id"`, so Postgres will almost certainly
  // drive that one from TransferItem_itemId_idx instead. Cost is bounded
  // either way (Transfer is small and purged 90 days after close). Note
  // receiverName is a plain String, NOT citext — so unlike Item.serialNumber
  // it needs no `::text` cast to reach this index. That cast exists there only
  // because citext's own ILIKE operator cannot use a text trigram index; do
  // not copy it here.
  @@index([receiverName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Transfer_receiverName_trgm_idx")
}

model TransferLine {
  id          String         @id @default(cuid())
  transfer    Transfer       @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferId  String
  lineNo      Int
  make        String
  model       String
  unitOfIssue String         @default("EA")
  qtyAuth     Int
  qtyIssued   Int
  items       TransferItem[]

  @@index([transferId])
}

model TransferItem {
  id             String       @id @default(cuid())
  line           TransferLine @relation(fields: [transferLineId], references: [id], onDelete: Cascade)
  transferLineId String
  // NULLABLE, ON DELETE SET NULL — deleting an item DETACHES its receipt lines
  // rather than being refused (this was RESTRICT) or destroying them (Cascade).
  // Receipts survive intact because they never join Item: the page and the DA
  // 2062 render `serialNumber` here plus make/model on TransferLine, all
  // snapshots taken when the receipt was created. processReturn selects on
  // `id`, not `itemId`, so a detached row is still returnable and a receipt
  // cannot become un-closable because someone deleted a device.
  item           Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId         String?
  serialNumber   String
  returnedAt     DateTime?

  @@index([itemId])
  @@index([transferLineId])
}

model ImportBatch {
  id           String   @id @default(cuid())
  createdBy    User     @relation("ImportBatches", fields: [createdById], references: [id])
  createdById  String
  filename     String
  addedCount   Int
  updatedCount Int      @default(0)
  skippedCount Int
  skipped      Json
  createdAt    DateTime @default(now())
  /// sha256 of the exact CSV text this batch was built from. Set only by the
  /// scheduled Drive import, which compares it against the newest non-null
  /// value to decide whether the linked export actually changed — NULL on every
  /// hand upload and on the /api/items/import route, both of which import
  /// whatever they are handed. Deliberately not unique: re-importing a
  /// previously seen export (a deliberate rollback) is a real change from what
  /// is current and must be allowed to run.
  sourceHash   String?

  @@index([createdById])
  // The dropped-off-network derivation asks two questions of this table on
  // every dashboard load — "when was the newest FLEET CENSUS?" and "which was
  // the first census after this device was last seen?" — and both filter on a
  // non-null sourceHash ordered by time.
  @@index([sourceHash, createdAt])
}

model ReturnTransaction {
  id                   String     @id @default(cuid())
  transfer             Transfer   @relation("TransferReturns", fields: [transferId], references: [id], onDelete: Cascade)
  transferId           String
  receiptNumber        String
  kind                 ReturnKind
  processedByUser      User?      @relation("ReturnsProcessed", fields: [processedByUserId], references: [id])
  processedByUserId    String?
  processedByName      String
  processedByEmail     String
  // The ink, deduplicated. Nullable exactly as the old inline column was. The
  // service layer rehydrates this into a `processedBySignature` data URL on read
  // (returns.service.ts), so the receipt page and the DA 2062 renderer are
  // unchanged — the dedup is a storage detail, not a change of shape.
  processedBySignatureSha   String?
  processedBySignatureAsset SignatureAsset? @relation("ReturnSignature", fields: [processedBySignatureSha], references: [sha256], onDelete: Restrict)
  returned             Json
  returnedCount        Int
  remainingCount       Int
  createdAt            DateTime   @default(now())

  @@index([transferId])
}

// [Service Queue] Service requested for a queued item.
enum ServiceType {
  REIMAGE
  REPAIR
  OTHER // free-text detail in ServiceQueueItem.serviceNote
}

// [Service Queue] Lifecycle for an item's service request.
enum ServiceQueueStatus {
  // In the queue: the item needs active service/intervention.
  PENDING
  // Service done. Retained (never deleted), drops off the active queue, and can
  // be reopened (PENDING) from the item detail page.
  COMPLETED
}

// [Service Queue] One service request per item. Present with status PENDING ==
// "needs service" (shown on the queue). The item may optionally be tied to the
// hand receipt it was flagged on (transferId), shown on the item detail page.
model ServiceQueueItem {
  id          String             @id @default(cuid())
  item        Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      String             @unique
  transfer    Transfer?          @relation("TransferQueueItems", fields: [transferId], references: [id], onDelete: SetNull)
  transferId  String?
  serviceType ServiceType
  serviceNote String?
  status      ServiceQueueStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Completion SLA timer. dueAt is set ONLY from a days value a human entered —
  // blank leaves it NULL = no deadline, and there is no per-service-type default
  // substituted behind the user's back (see sla.ts).
  //
  // Both columns follow one rule: a NEW ROUND of service resets them, an edit to
  // a LIVE request does not. So re-flagging or reopening a COMPLETED row clears
  // both first (service-queue.service.ts), while re-saving a PENDING row's type
  // or note writes neither — an overdue alert is per-deadline, so an unchanged
  // deadline that already alerted must not re-alert, and a new job must not
  // inherit the finished one's date or its "already alerted" stamp. Changing the
  // deadline itself (setServiceDeadline) always re-arms the alert.
  dueAt            DateTime?
  overdueAlertedAt DateTime?

  @@index([status])
  @@index([transferId])
  @@index([dueAt])
}

// History of edits to an Item's loggable fields. One row per save that actually
// changed something (a no-op save writes nothing).
model ItemEdit {
  id           String   @id @default(cuid())
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId       String
  // Nullable + SetNull, with a denormalized name snapshot, so history survives
  // the editor's account being deleted (mirrors ReturnTransaction.processedBy*).
  editedBy     User?    @relation("ItemEdits", fields: [editedById], references: [id], onDelete: SetNull)
  editedById   String?
  editedByName String
  // [{ field, from, to }] — only the fields that changed.
  changes      Json
  createdAt    DateTime @default(now())

  @@index([itemId])
  @@index([createdAt])
}

// One signature image, stored ONCE and addressed by the SHA-256 of its bytes.
//
// Why this table exists: `ItemAudit` and `ReturnTransaction` each need a snapshot
// of the ink that was used, and both used to store the full PNG data URL inline.
// Those blobs are ~12 KB each and are byte-identical across every row a given
// admin signs — production held 31 audit rows carrying 1 distinct image, so
// `ItemAudit` was the third-largest table in the database on 31 rows. Auditing
// the whole fleet once would have written ~15 MB to say one 12 KB thing 1,204
// times, against a 500 MB ceiling. TOAST cannot absorb it: base64-of-PNG is
// already-compressed bytes, so pglz gets nothing.
//
// Why it does NOT undo the denormalization it replaces: those columns were
// inline so history survives deletion of the source `Signature` row (see the
// ItemAudit / ReturnTransaction comments). A row here is CONTENT-ADDRESSED —
// the key IS the hash of the bytes, so the image behind a given sha can never
// change — and nothing ever deletes from this table (both FKs are RESTRICT).
// A snapshot is therefore still immutable and still independent of `Signature`.
// Do NOT add a delete path or a GC sweep: the row count is bounded by the number
// of distinct signatures ever used (one per admin per signature name), and a
// reachability sweep over audit history to reclaim 12 KB is a bad trade against
// the risk of unlinking a signed record.
//
// Deliberately NOT indexed on the referencing side. `ItemAudit.signatureSha` and
// `ReturnTransaction.processedBySignatureSha` carry no index because the only
// query that would use one is the RESTRICT check on deleting an asset, which
// never happens — and a 64-char hex B-tree over every audit row would give back
// a chunk of the space this table exists to save.
model SignatureAsset {
  // Lowercase hex SHA-256 of the image string's UTF-8 bytes. Computed by
  // `signatureSha256` (src/lib/signature-hash.ts); the backfill migration
  // computes the same value as `encode(sha256(convert_to(col,'UTF8')),'hex')`.
  sha256    String   @id
  image     String // PNG data URL
  byteLen   Int
  createdAt DateTime @default(now())

  itemAudits ItemAudit[]         @relation("AuditSignature")
  returns    ReturnTransaction[] @relation("ReturnSignature")
}

// A named signature belonging to an ADMIN account. `name` is the technician the
// signature belongs to — it is printed on the DA 2062 as the signer when this
// signature is chosen on a return, so it is an identity, not a label.
// Non-admin accounts keep the single `User.signatureImage` instead.
model Signature {
  id        String   @id @default(cuid())
  user      User     @relation("UserSignatures", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  image     String // PNG data URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

// A saved recipient for hand receipts — shared org-wide (any signed-in user
// reads it for autofill; only admins write to it). Distinct from User: these are
// outside people who receive equipment and have no login account.
model Contact {
  id            String  @id @default(cuid())
  rank          String?
  // Split (rather than a single free-text `name` like User.name) so ordering by
  // last name is a plain indexed DB sort. Parsing a surname out of one column
  // misfiles "Van Der Berg" and "Doe Jr.". Transfer.receiverName stays a single
  // String; autofill composes "First Last" when filling it.
  //
  // A parse DOES now exist, in ONE place: `parsePartyName`
  // (src/modules/contacts/party-name.ts), used only by `upsertContactFromParty`
  // to file a hand-receipt party whose name arrived as one free-text field. It
  // does not retract the warning above — it splits on a comma where there is
  // one, refuses anything it cannot split into two non-empty halves, and is
  // best-effort on a row an admin can correct. Do not add a second parser, and
  // do not collapse these two columns back into one.
  firstName     String
  lastName      String
  unit          String?
  contactNumber String?
  // citext + unique: one inbox, one contact. Mirrors User.email — the app
  // lowercases on write, so a mixed-case row would otherwise be unfindable by
  // lookups and would not collide with its lowercase twin.
  email         String  @unique @db.Citext

  // Nullable + SetNull (mirrors ItemEdit.editedBy): the shared book must survive
  // deletion of the account that happened to add a row.
  createdBy   User?   @relation("CreatedContacts", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
}

// History of possession audits for an item. One row per audit event; an item's
// audit status is derived from the newest row (see modules/audit/audit.status.ts).
// Nullable auditor + denormalized name snapshot so history survives deletion of
// the acting account or the source Signature (mirrors ItemEdit /
// ReturnTransaction).
//
// The signature itself is NOT denormalized inline any more — it is a RESTRICT
// reference into the content-addressed `SignatureAsset`, which preserves the same
// two guarantees (immutable bytes, independent of `Signature`) at ~65 bytes per
// row instead of ~12,000. See the SignatureAsset comment for why.
model ItemAudit {
  id             String   @id @default(cuid())
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId         String
  auditedBy      User?    @relation("ItemAudits", fields: [auditedById], references: [id], onDelete: SetNull)
  auditedById    String?
  auditedByName  String
  signerName     String
  signatureSha   String
  signatureAsset SignatureAsset @relation("AuditSignature", fields: [signatureSha], references: [sha256], onDelete: Restrict)
  createdAt      DateTime @default(now())

  @@index([itemId, createdAt])
}

// Single-row org config for the public-access PIN gate. `id` is pinned to
// "singleton" so there is exactly one row (upserted). Stores only the bcrypt
// hash of the 8-digit PIN — never the PIN. `updatedBy` is nullable + SetNull so
// the row survives deletion of the admin who last set it (mirrors ItemEdit).
// New tables inherit RLS-enabled/deny-all via the rls_auto_enable trigger; the
// app reaches this only through Prisma (see CLAUDE.md §6).
model PublicAccessSetting {
  id          String   @id @default("singleton")
  pinHash     String
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("PinUpdates", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?

  @@index([updatedById])
}

// An in-progress hand receipt saved from the builder. PRIVATE to its author —
// a deliberate exception to this app's role-based, org-shared authorization
// (see CLAUDE.md §1): a filed receipt is a shared organizational record, but a
// half-typed form is personal working state.
//
// The recipient signature is deliberately NOT stored. Ink attests to a specific
// item list (ReceiptBuilderForm discards it whenever the list changes), so a
// signature restored onto a since-edited draft would attest to a list it never
// covered.
model ReceiptDraft {
  id     String @id @default(cuid())
  user   User   @relation("ReceiptDrafts", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Denormalized from `payload` on every save so the account list never has to
  // deserialize a payload to render a row. Written from the same parsed object,
  // so they cannot drift.
  recipientName String?
  itemCount     Int     @default(0)

  // The builder form's fields, minus the signature. Shape is enforced by
  // receiptDraftSchema on every write AND every read — a Json column is untyped
  // at the DB level, and a payload written by an older deploy must not be able
  // to crash the builder.
  payload Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt]) // the /account list
  @@index([updatedAt])         // the nightly purge sweep
}
