# ---- Local development ----
# Points at the Docker Postgres from docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/handreceipt?schema=public"

# Auth.js secret. Generate one with: npx auth secret
AUTH_SECRET="generate-with: npx auth secret"

# Absolute base URL of the app. Used to build scannable QR code links.
APP_URL="http://localhost:3000"

# Transactional email (optional in dev — without these, receipt links are
# logged to the console via a stub sender instead of actually being sent).
#
# Gmail (nodemailer) is the preferred sender and takes precedence over Resend:
# .mil recipients block our custom domain, so mail must originate from the
# gmail.com account. Set both to enable. GMAIL_APP_PASSWORD is a 16-char Google
# App Password (requires 2-Step Verification), NOT the account password. The
# From address is always the GMAIL_USER account ("DCSIM Service Desk <user>").
GMAIL_USER="dcsimservicedesk@gmail.com"
GMAIL_APP_PASSWORD=
# Fallback sender (used only when Gmail vars above are unset).
RESEND_API_KEY=
EMAIL_FROM="DCSIM <receipts@turtolabs.com>"
# Admin/records inbox: when set, receives a copy of every NEW hand receipt
# ("NEW: <HR>") and every completed/full return ("CLOSED <HR>"), with the PDF
# attached. Partial returns are not copied. Leave unset to disable.
ADMIN_INBOX_EMAIL=
# G6 service desk: when set, CC'd on return notifications (partial + full).
G6_SERVICE_DESK_EMAIL=

# ---- Production (Vercel + Supabase) ----
# DATABASE_URL  -> Supabase TRANSACTION pooler (port 6543), used by the app at
#                  runtime. Must end with ?pgbouncer=true
# DIRECT_URL    -> Supabase SESSION pooler / direct connection (port 5432), used
#                  only by `prisma migrate deploy`.
# AUTH_SECRET   -> a fresh secret (do NOT reuse the dev one): npx auth secret
# APP_URL       -> your deployed URL, e.g. https://service-desk-app.vercel.app
#
# Optionally override the seeded admin (defaults: admin@example.com / ChangeMe123!):
# SEED_ADMIN_EMAIL="admin@yourorg.com"
# SEED_ADMIN_PASSWORD="a-strong-password"

# Ed25519 private key (PKCS#8 PEM) that signs each hand receipt's non-repudiation
# seal. Optional/best-effort: unset means receipts are created unsealed. Generate:
#   node -e "const {generateKeyPairSync}=require('crypto');const {privateKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}))"
# Dev: one line, \n-escaped, quoted. Prod (Vercel): paste the multi-line PEM as-is.
SIGNING_PRIVATE_KEY=

# Set to "true" to require an 8-digit PIN for logged-out visitors to view the
# public pages (home search, item pages, receipts). Absent = open access.
# The PIN itself is set in-app at /admin (stored bcrypt-hashed in the DB).
PUBLIC_ACCESS_PIN_ENABLED="false"

# ---- Rate limiting (docs/SECURITY.md §12) ----
# Redis store for the IP rate limiter. `@vercel/kv` is DEPRECATED by Vercel;
# attach a Redis integration from the Vercel Marketplace instead and it injects
# these two vars automatically (a store provisioned directly at Upstash exports
# them as UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN, also accepted).
#
# LEAVE THEM UNSET AND THE LIMITER STILL WORKS, but its counters live in one
# process — on Vercel that means it only throttles requests landing on the same
# warm instance. Fine for local dev; NOT the production posture.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Escape hatch for local work only — "true" disables the limiter AND the
# browser check, so a dev server can be driven with curl.
# Never set this in a deployed environment.
RATE_LIMIT_DISABLED=

# ---- Cloudflare Turnstile (docs/SECURITY.md §13) ----
# The CAPTCHA on /login and /forgot-password. BOTH must be set for it to run at
# all — a site key alone renders a widget nobody checks, and a secret alone
# would refuse every sign-in because no form could produce a token. With either
# missing the widget is not rendered and verification is skipped, which is how
# dev, CI and an un-keyed deploy keep working.
#
# Get a pair from the Cloudflare dashboard (Turnstile → Add site). Cloudflare
# also publishes TEST keys that always pass, useful for local work:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# and a pair that always FAILS, for checking the refusal path:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="2x00000000000000000000AB"
#   TURNSTILE_SECRET_KEY="2x0000000000000000000000000000000AA"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
